{
  "version": 2,
  "build": {
    "env": {
      "PIP_NO_CACHE_DIR": "1",
      "PIP_DISABLE_PIP_VERSION_CHECK": "1"
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{frontend/**,venv/**,.venv/**,tests/**,docs/**,*.docx}"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  }
}
